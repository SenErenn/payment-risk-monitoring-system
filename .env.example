# PostgreSQL
POSTGRES_USER=payscope
POSTGRES_PASSWORD=change_me
POSTGRES_DB=payment_risk_monitoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full-stack Docker (optional)
API_PORT=5067
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
# Compose API service defaults to Production; migrate/seed stay on via flags below.
Database__MigrateOnStartup=true
Database__SeedOnStartup=true

# Backend API (local `dotnet run` — keep Development)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=payment_risk_monitoring;Username=payscope;Password=change_me

# JWT (must be at least 32 characters)
Jwt__Secret=change_me_to_a_long_random_secret_at_least_32_chars
Jwt__Issuer=PaymentRiskMonitoring
Jwt__Audience=PaymentRiskMonitoring
Jwt__ExpiryMinutes=60

# Frontend (local Vite)
VITE_API_BASE_URL=http://localhost:5067
