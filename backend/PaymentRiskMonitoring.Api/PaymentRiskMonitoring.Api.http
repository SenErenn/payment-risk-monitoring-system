@baseUrl = http://localhost:5067
@accessToken = replace_with_jwt_after_login

### Health
GET {{baseUrl}}/api/health
Accept: application/json

###
### Database ready
GET {{baseUrl}}/health/ready
Accept: application/json

###
### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@payscope.local",
  "password": "Admin123!"
}

###
### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Access profile
GET {{baseUrl}}/api/auth/access
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Admin check
GET {{baseUrl}}/api/auth/admin-check
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Analyst check
GET {{baseUrl}}/api/auth/analyst-check
Authorization: Bearer {{accessToken}}
Accept: application/json
