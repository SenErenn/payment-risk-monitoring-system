@baseUrl = http://localhost:5067
@accessToken = replace_with_jwt_after_login
@merchantId = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
@cardId = e1111111-1111-1111-1111-111111111111
@transactionId = f1111111-1111-1111-1111-111111111111

### Health
GET {{baseUrl}}/api/health
Accept: application/json

###
### Database ready
GET {{baseUrl}}/health/ready
Accept: application/json

###
### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@payscope.local",
  "password": "Admin123!"
}

###
### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Access profile
GET {{baseUrl}}/api/auth/access
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Admin check
GET {{baseUrl}}/api/auth/admin-check
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Analyst check
GET {{baseUrl}}/api/auth/analyst-check
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### List merchants
GET {{baseUrl}}/api/merchants?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Search merchants
GET {{baseUrl}}/api/merchants?page=1&pageSize=10&search=cafe&isActive=true
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Merchant detail
GET {{baseUrl}}/api/merchants/{{merchantId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Create merchant
POST {{baseUrl}}/api/merchants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "merchantCode": "MCH-DEMO-99",
  "name": "Demo Merchant",
  "category": "Retail",
  "isActive": true
}

###
### Update merchant
PUT {{baseUrl}}/api/merchants/{{merchantId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "PayScope Market Istanbul Updated",
  "category": "Grocery"
}

###
### Activate merchant
POST {{baseUrl}}/api/merchants/{{merchantId}}/activate
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Deactivate merchant
POST {{baseUrl}}/api/merchants/{{merchantId}}/deactivate
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### List cards
GET {{baseUrl}}/api/cards?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Search cards
GET {{baseUrl}}/api/cards?page=1&pageSize=10&search=4242&status=Active
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Card detail
GET {{baseUrl}}/api/cards/{{cardId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Create card
POST {{baseUrl}}/api/cards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "cardType": "Credit",
  "creditLimit": 12000,
  "availableLimit": 12000,
  "lastFourDigits": "1234",
  "status": "Active"
}

###
### Update card limits
PUT {{baseUrl}}/api/cards/{{cardId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "creditLimit": 15000,
  "availableLimit": 11000
}

###
### Update card status
POST {{baseUrl}}/api/cards/{{cardId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "Blocked"
}

###
### Activate card
POST {{baseUrl}}/api/cards/{{cardId}}/activate
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Block card
POST {{baseUrl}}/api/cards/{{cardId}}/block
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Deactivate card
POST {{baseUrl}}/api/cards/{{cardId}}/deactivate
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### List transactions
GET {{baseUrl}}/api/transactions?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Search transactions
GET {{baseUrl}}/api/transactions?page=1&pageSize=10&search=TXN&status=Approved
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Filter transactions (date / amount / payment type / sort)
GET {{baseUrl}}/api/transactions?page=1&pageSize=10&status=Approved&paymentType=Contactless&minAmount=10&maxAmount=1000&createdFrom=2026-01-01T00:00:00Z&createdTo=2026-12-31T23:59:59Z&sortBy=amount&sortDirection=desc
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Filter by merchant and card
GET {{baseUrl}}/api/transactions?page=1&pageSize=10&merchantId={{merchantId}}&cardId={{cardId}}&sortBy=createdAt&sortDirection=desc
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Transaction detail
GET {{baseUrl}}/api/transactions/{{transactionId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###
### Create transaction (payment)
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Idempotency-Key: demo-payment-key-001

{
  "merchantId": "{{merchantId}}",
  "cardId": "{{cardId}}",
  "amount": 250.50,
  "currency": "TRY",
  "paymentType": "Contactless",
  "idempotencyKey": "demo-payment-key-001"
}

###
### Replay same idempotency key (should not double-charge)
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Idempotency-Key: demo-payment-key-001

{
  "merchantId": "{{merchantId}}",
  "cardId": "{{cardId}}",
  "amount": 250.50,
  "currency": "TRY",
  "paymentType": "Contactless",
  "idempotencyKey": "demo-payment-key-001"
}
